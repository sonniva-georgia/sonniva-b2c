APP_NAME=Sonniva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ka
APP_FALLBACK_LOCALE=ka
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sales_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS=
MAIL_TO_NAME="Sonniva Sales"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Must match sonniva-mobile's NATIVEPHP_DEEPLINK_SCHEME.
MOBILE_APP_DEEPLINK_SCHEME=sonniva

DEBUGBAR_ENABLED=false
INERTIA_SSR_THROW_ON_ERROR=false

BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_SCOPE="https://api.businesscentral.dynamics.com/.default"
BC_TOKEN_URL=
BC_API_BASE_URL=

ONWAY_USERNAME=
ONWAY_API_KEY=

FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_API_VERSION=2.0
FLITT_REQUEST_TYPE=json
FLITT_CALLBACK_URL="${APP_URL}"
TBC_IBAN=

BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_API_KEY=
BOG_SECRET=
BOG_API_URL=
BOG_CALLBACK_URL="${APP_URL}"
BOG_IBAN=

PCB_TEST_URL=
PCB_TEST_MERCHANT_ID=

SMS_OFFICE_KEY=
SMS_OFFICE_SENDER=
SMS_OFFICE_CALLBACK_URL=

GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
ANALYTICS_PROPERTY_ID=

VITE_APP_NAME="${APP_NAME}"
